{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["bun-types"],
    // The examples and the consumer check import the package by its published name; resolve that
    // to the source, so neither needs a build first.
    "paths": {
      "@thirkettle/collection-fingerprint": ["./src/index.ts"],
      "@thirkettle/collection-fingerprint/react": ["./src/react/index.ts"]
    }
  },
  "include": ["src", "scripts"]
}
